{
  "name": "kindergarten-app",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "packages/types"
  ],
  "scripts": {
    "lint": "eslint frontend/src backend/src packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git rev-parse --git-dir 2>/dev/null && lefthook install || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "lefthook": "^1.10.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "backend/src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.ts": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
