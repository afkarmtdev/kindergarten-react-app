{
  "permissions": {
    "allow": [
      "Bash(bun add sonner)",
      "Bash(bun add pino pino-pretty)",
      "Bash(bun run tsc --noEmit)",
      "Bash(bun run lint)",
      "Bash(bun run test:backend)",
      "Bash(npx tsc --noEmit)",
      "Bash(bunx --bun tsc --noEmit)",
      "Bash(bun run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx --prefix frontend tsc --noEmit --pretty false)",
      "Bash(bun test:*)",
      "Bash(npx eslint:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
