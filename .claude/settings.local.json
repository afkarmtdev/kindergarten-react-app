{
  "permissions": {
    "allow": [
      "Bash(bun add sonner)",
      "Bash(bun add pino pino-pretty)",
      "Bash(bun run tsc --noEmit)",
      "Bash(bun run lint)",
      "Bash(bun run test:backend)",
      "Bash(npx tsc --noEmit)",
      "Bash(bunx --bun tsc --noEmit)",
      "Bash(bun run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx --prefix frontend tsc --noEmit --pretty false)",
      "Bash(bun test:*)",
      "Bash(npx eslint:*)",
      "Bash(bunx tsc:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- .)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(bun run deploy*)"
    ]
  }
}
